# Copy to .env.local and adjust. Only VITE_* variables reach the browser — never add secrets here
# (no Google client secret, DB credentials, JWT secret, SMTP password).

# Backend API base URL incl. prefix. Leave EMPTY in development to use the Vite proxy below
# (FE calls same-origin /api/v1). Calling the Backend directly also works since BE v1.1.1, which allows
# CORS from http://localhost:5173 and :3000: VITE_API_URL=http://localhost:8080/api/v1.
# For other origins (deploy), add the FE origin to APP_CORS_ALLOWED_ORIGINS in the Backend .env.
VITE_API_URL=

# Dev server only: forward /api/* to this Backend origin.
VITE_DEV_PROXY_TARGET=http://localhost:8080

# Optional: Google OAuth client id. Normally read from GET /meta/config (googleClientId).
VITE_GOOGLE_CLIENT_ID=

# Request timeout in milliseconds.
VITE_API_TIMEOUT_MS=15000
